# Twitch: normaler Betrieb benötigt KEINE manuell kopierten Tokens oder User-IDs mehr.
# Login erfolgt im Adminpanel per Twitch Device Code Flow und wird lokal in data/twitch_auth.json gespeichert.
# Die öffentliche Client-ID ist zusätzlich in config/challenge_config.json konfigurierbar.
# Optional kann sie hier überschrieben werden:
TWITCH_CLIENT_ID=

# Legacy-/Fallback-Unterstützung für bereits vorhandene manuelle Setups (optional):
TWITCH_USER_ACCESS_TOKEN=
TWITCH_BROADCASTER_ID=
TWITCH_BOT_USER_ID=
TWITCH_EVENTSUB_USER_ID=
TWITCH_MEDIPACK_REWARD_ID=

# Optional FE-C bridge executable. The helper must support: status, grade <percent>, restore.
BICYCLE_FEC_HELPER=

# Optional runtime overrides
BICYCLE_STREAM_PORT=5050
BICYCLE_DISABLE_DISTANCE_PERSIST=0
